# ---------------------------------------------------------------------------
# Plantilla de variables de entorno - Mesa de Ayuda (Help Desk)
#
# Copia este archivo como ".env" y rellena los valores:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux / macOS:         cp .env.example .env
#
# ".env" esta en .gitignore: no se sube al repositorio.
# En Vercel las variables se configuran en Project > Settings > Environment
# Variables (no se sube ningun archivo).
# ---------------------------------------------------------------------------

# --- Base de datos -------------------------------------------------------
# LOCAL: SQLite (recomendado para desarrollo).
DATABASE_URL=sqlite:///helpdesk.db
#
# VERCEL / PRODUCCION: PostgreSQL obligatorio (Neon, Supabase, Railway...).
# Pega la URL que entrega el proveedor:
#   postgresql://USUARIO:CLAVE@host:puerto/basedatos
#
# Usa la conexion DIRECTA, no el pooler en modo transaction.
# DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# --- Seguridad ------------------------------------------------------------
# Clave para firmar las cookies de sesion. OBLIGATORIA cambiarla en
# produccion y NO cambiarla despues (cerraria todas las sesiones).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga

# --- Panel tecnico --------------------------------------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# --- Otros ----------------------------------------------------------------
# Diferencia horaria respecto a UTC. Colombia = -5
TZ_OFFSET=-5

# Puerto del servidor local. En Vercel lo define la plataforma.
PORT=5000
